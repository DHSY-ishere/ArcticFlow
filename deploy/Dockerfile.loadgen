FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY router ./router
COPY benchmark ./benchmark
RUN CGO_ENABLED=0 go build -trimpath -o /out/loadgen ./benchmark/cmd/loadgen

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/loadgen /loadgen
ENTRYPOINT ["/loadgen"]
