   "options": {}
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Errors and failovers",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 30,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(arctic_requests_total{outcome=\"error\"}[15s]))",
     "legendFormat": "errors/s",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
